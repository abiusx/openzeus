+    // Local addition (zeus project oracle): raw zone dumps. ZEUS_STATE_DUMP=DIR writes
+    // DIR/tick_NNNNNN.bin (all zones concatenated in kZones order) every ZEUS_STATE_DUMP_EVERY
+    // ticks (default 1) within ZEUS_STATE_DUMP_FROM..ZEUS_STATE_DUMP_TO (default all), and DIR/zones.txt once.
+    void dump(uint64_t t) {
+        static const char* dir = std::getenv("ZEUS_STATE_DUMP");
+        if (!dir) return;
+        // ZEUS_STATE_DUMP_ZONES="17,16,35": only these blocks (zones.txt lists what is written; default all).
+        static const std::string only = std::getenv("ZEUS_STATE_DUMP_ZONES")
+            ? "," + std::string(std::getenv("ZEUS_STATE_DUMP_ZONES")) + "," : "";
+        auto wanted = [](const StateZone& z) {
+            return only.empty() || only.find("," + std::to_string(z.block) + ",") != std::string::npos;
+        };
+        // ZEUS_STATE_DUMP_EXTRA="0xC5BD98:51984,...": memory outside the save zones (e.g. the invaders' presence grid),
+        // written after the zones, listed in zones.txt with block -2.
+        static const std::vector<StateZone> extra = [] {
+            std::vector<StateZone> v;
+            if (const char* e = std::getenv("ZEUS_STATE_DUMP_EXTRA")) {
+                std::string s(e);
+                size_t i = 0;
+                while (i < s.size()) {
+                    size_t j = s.find(',', i);
+                    if (j == std::string::npos) j = s.size();
+                    std::string item = s.substr(i, j - i);
+                    size_t c = item.find(':');
+                    if (c != std::string::npos)
+                        v.push_back({-2, static_cast<uint32_t>(std::strtoul(item.substr(0, c).c_str(), nullptr, 16)),
+                                     static_cast<uint32_t>(std::strtoul(item.substr(c + 1).c_str(), nullptr, 10))});
+                    i = j + 1;
+                }
+            }
+            return v;
+        }();
+        static const uint64_t every = std::getenv("ZEUS_STATE_DUMP_EVERY")
+            ? std::strtoull(std::getenv("ZEUS_STATE_DUMP_EVERY"), nullptr, 10) : 1;
+        if (t == 0) {
+            std::string idx = std::string(dir) + "/zones.txt";
+            if (std::FILE* f = std::fopen(idx.c_str(), "w")) {
+                uint32_t off = 0;
+                for (const StateZone& z : kZones) {
+                    if (!wanted(z)) continue;
+                    std::fprintf(f, "%d 0x%08X %u %u\n", z.block, z.address, z.size, off);
+                    off += z.size;
+                }
+                for (const StateZone& z : extra) {
+                    std::fprintf(f, "%d 0x%08X %u %u\n", z.block, z.address, z.size, off);
+                    off += z.size;
+                }
+                std::fclose(f);
+            }
+        }
+        static const uint64_t from = std::getenv("ZEUS_STATE_DUMP_FROM")
+            ? std::strtoull(std::getenv("ZEUS_STATE_DUMP_FROM"), nullptr, 10) : 0;
+        static const uint64_t to = std::getenv("ZEUS_STATE_DUMP_TO")
+            ? std::strtoull(std::getenv("ZEUS_STATE_DUMP_TO"), nullptr, 10) : UINT64_MAX;
+        if (every == 0 || t % every || t < from || t > to) return;
+        char name[64];
+        std::snprintf(name, sizeof name, "/tick_%06llu.bin", (unsigned long long)t);
+        std::string path = std::string(dir) + name;
+        if (std::FILE* f = std::fopen(path.c_str(), "wb")) {
+            for (const StateZone& z : kZones)
+                if (wanted(z)) std::fwrite(process_.cpu().host(z.address), 1, z.size, f);
+            for (const StateZone& z : extra) std::fwrite(process_.cpu().host(z.address), 1, z.size, f);
+            std::fclose(f);
+        }
+    }
