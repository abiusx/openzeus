+                        if (buf[0] == '#') continue;
+                        unsigned long long tk; unsigned int ad, sz; long long v;
+                        if (std::sscanf(buf, "%llu %x %u %lld", &tk, &ad, &sz, &v) == 4) pokes.push_back({tk, ad, sz, v});
+                    }
